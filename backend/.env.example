# Copy to .env and fill in real values. Never commit .env.
PORT=5001
DATABASE_URL="postgresql://neondb_owner:npg_pwv6L2KnCcRh@ep-wispy-rain-au6kbp5z.c-10.us-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Must be at least 32 characters in production.
JWT_SECRET= a6914b721f5735a408bdca5b9096b42fd337a3369b29703ae01c5dfaf31526d3
# Token lifetime (default 12h). Examples: 30m, 8h, 1d
JWT_EXPIRES_IN=12h
FRONTEND_URL=http://localhost:3000
# Set to 1 when running behind a reverse proxy (so rate limiting sees real client IPs)
# TRUST_PROXY=1
# NODE_ENV=production

# --- Student onboarding (Phase 3) ---
# Public URL of the FRONTEND. Activation/reset links are built from it, so set it correctly in production.
# (FRONTEND_URL above is also used for CORS.)
# Activation link lifetime in hours (default 168 = 7 days) and reset link lifetime in minutes (default 60)
# INVITE_TTL_HOURS=168
# RESET_TTL_MINUTES=60
# Optional: only accept student emails from these domains (comma-separated). Leave unset to allow any.
# ALLOWED_EMAIL_DOMAINS=college.edu

# --- Email delivery (OPTIONAL) ---
# Leave SMTP_HOST unset and SARP will NOT send email: the administrator hands out activation links
# (Admin > Student Import > Activation links) and the UI says so. Set all of these to enable invitations.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM="SARP <no-reply@college.edu>"

# --- First administrator and demo data ---
# There is no default admin in production. Create the first Super Admin on the server:
#   npm run admin:create -- --email you@college.edu --name "Your Name"
# It prints a one-time activation link (never a password). Demo accounts (npm run seed) have publicly
# known passwords, so the seed script refuses to run when NODE_ENV=production unless you set:
# ALLOW_DEMO_SEED=true

# Largest proof file a student may upload, in MB (1-50, default 10)
MAX_PROOF_MB=10
